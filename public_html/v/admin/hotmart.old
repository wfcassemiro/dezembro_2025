<?php
session_start();
require_once __DIR__ . '/../config/database.php';

// Verificar se é admin
if (!isset($_SESSION['user_id']) || !isset($_SESSION['is_admin']) || !$_SESSION['is_admin']) {
    header('Location: /login.php');
    exit;
}

$page_title = 'Integração Hotmart - Admin';
$message = '';
$error = '';
$sync_details = []; // Array para o relatório visual

// Processar sincronização com API da Hotmart
if (isset($_POST['sync_hotmart'])) {
    try {
        $sync_result = syncWithHotmart();
        if ($sync_result['success']) {
            $message = 'Sincronização realizada com sucesso! ' . $sync_result['message'];
            $sync_details = $sync_result['details'] ?? [];
        } else {
            $error = 'Erro na sincronização: ' . $sync_result['message'];
        }
    } catch (Exception $e) {
        $error = 'Erro durante a sincronização: ' . $e->getMessage();
    }
}

// Função para sincronizar com Hotmart
function syncWithHotmart() {
    global $pdo;
    
    $processed_users = [];
    
    // Carregar configurações (Usando include para garantir retorno do array mesmo se já carregado)
    $config = include __DIR__ . '/../config/hotmart_config.php';
    
    if (!is_array($config)) {
        return ['success' => false, 'message' => 'Erro ao carregar configurações da Hotmart.'];
    }
    
    $client_id = $config['api']['client_id'];
    $client_secret = $config['api']['client_secret'];
    $basic_token = $config['api']['basic_token'];
    $auth_url = $config['api']['auth_url'];
    $sales_url = $config['api']['sales_url'];
    $days_to_sync = 7; // Sincronizar últimos 7 dias

    // 1. Obter Token de Acesso (Método idêntico ao arquivo original)
    $ch = curl_init();
    $auth_full_url = $auth_url . '?grant_type=client_credentials&client_id=' . $client_id . '&client_secret=' . $client_secret;
    
    curl_setopt($ch, CURLOPT_URL, $auth_full_url);
    curl_setopt($ch, CURLOPT_POST, 1);
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Content-Type: application/json',
        'Authorization: Basic ' . $basic_token
    ]);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    
    $response = curl_exec($ch);
    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($http_code !== 200) {
        return ['success' => false, 'message' => "Falha na autenticação Hotmart. Código: $http_code. Resposta: $response"];
    }

    $auth_data = json_decode($response, true);
    if (!isset($auth_data['access_token'])) {
        return ['success' => false, 'message' => 'Token de acesso não retornado.'];
    }
    
    $access_token = $auth_data['access_token'];

    // 2. Buscar Vendas (Histórico)
    $start_date = strtotime("-{$days_to_sync} days") * 1000;
    $end_date = time() * 1000;
    
    // URL concatenada manualmente como no original
    $url = $sales_url . "?transaction_status=APPROVED&transaction_status=COMPLETE&start_date=$start_date&end_date=$end_date&max_results=100";

    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $url);
    curl_setopt($ch, CURLOPT_HTTPHEADER, [
        'Content-Type: application/json',
        'Authorization: Bearer ' . $access_token
    ]);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    
    $sales_response = curl_exec($ch);
    $sales_data = json_decode($sales_response, true);
    curl_close($ch);

    if (!isset($sales_data['items'])) {
        // Se a resposta for válida mas sem itens, não é erro
        return ['success' => true, 'message' => 'Nenhuma venda encontrada no período.', 'details' => []];
    }

    // 3. Processar Usuários
    $count_new = 0;

    foreach ($sales_data['items'] as $sale) {
        if (!isset($sale['buyer']['email']) || !isset($sale['buyer']['name'])) continue;

        $buyer = $sale['buyer'];
        $email = $buyer['email'];
        $name = $buyer['name'];
        
        $status_log = '';
        $user_id_db = null;

        try {
            // Verificar se usuário existe
            $stmt = $pdo->prepare("SELECT id FROM users WHERE email = ?");
            $stmt->execute([$email]);
            $existing_user = $stmt->fetch();

            if ($existing_user) {
                $user_id_db = $existing_user['id'];
                $status_log = '<span style="color: #f39c12; font-weight: 500;">Já registrado</span>';
                
                // Opcional: Reativar usuário se estiver inativo
                // $pdo->prepare("UPDATE users SET is_active = 1 WHERE id = ?")->execute([$user_id_db]);
                
            } else {
                // Criar Novo Usuário
                $stmt = $pdo->prepare("INSERT INTO users (name, email, role, created_at, is_active) VALUES (?, ?, 'subscriber', NOW(), 1)");
                $stmt->execute([$name, $email]);
                $user_id_db = $pdo->lastInsertId();
                
                $count_new++;
                $status_log = '<span style="color: #2ecc71; font-weight: bold;"><i class="fas fa-plus-circle"></i> Novo Usuário</span>';
            }
        } catch (Exception $e) {
            $status_log = '<span style="color: #e74c3c;">Erro: ' . $e->getMessage() . '</span>';
        }

        // Adiciona ao relatório detalhado
        $processed_users[] = [
            'name' => $name,
            'email' => $email,
            'status' => $status_log,
            'id' => $user_id_db
        ];
    }

    return [
        'success' => true, 
        'message' => "Processamento concluído. Novos usuários: $count_new.",
        'details' => $processed_users
    ];
}

